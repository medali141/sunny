     <string notr="true">.rounded-button {
  /* Default Styling */
  background-color: white; /* Ensure the background is white */
  color: black;
  font-weight: bold;
  border: none;
  border-radius: 15px; 
  padding: 8px 15px; 
  display: inline-block;
  cursor: pointer;
  /* Other styles from the previous example */
}

/* Interaction States */

.rounded-button:hover {
  background-color: white; /* Keep the background white on hover */
  /* Optional: You can add a slight box-shadow here for visual feedback */
  /* box-shadow: 0 0 5px rgba(0, 0, 0, 0.1); */
}

.rounded-button:active,
.rounded-button:focus {
  background-color: white; /* Keep the background white when clicked or focused */
  /* Remove default outline, which can sometimes be black/blue */
  outline: none; 
}</string>
