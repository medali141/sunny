      <property name="styleSheet">
       <string notr="true">QCalendarWidget {
    background-color: #FFFFFF;          /* white background */
    color: #1C3D70;                     /* blue day numbers */
    border: 1px solid #2A5CAB;          /* blue border */
    font: 12pt &quot;Segoe UI&quot;;
}

QCalendarWidget QToolButton {
    background-color: #FFFFFF;          /* dark blue nav bar buttons */
    color: #FFFF00;                      /* yellow text */
    border: none;
    height: 25px;
    width: 50px;
}

QCalendarWidget QToolButton:hover {
    background-color: #2A5CAB;          /* lighter blue hover */
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;                        /* hide dropdown arrow */
}

QCalendarWidget QSpinBox {
    background-color: #1C3D70;          /* blue spin boxes */
    color: #FFFF00;                      /* yellow text */
    border: 1px solid #2A5CAB;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1C3D70;          /* blue nav bar */
}

QCalendarWidget QAbstractItemView {
    selection-background-color: #FFFF00; /* yellow selected day */
    selection-color: #1C3D70;            /* blue text on selected */
    background-color: #FFFFFF;           /* white day grid */
    color: #1C3D70;                       /* blue day numbers */
    gridline-color: #2A5CAB;              /* blue grid lines */
}
</string>
